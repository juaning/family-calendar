# Secrets — never commit
.env
.env.local
*.env
credentials.json
token.json
secrets/*
!secrets/.gitkeep

# Backend runtime data (keep the directory itself via .gitkeep, ignore contents)
backend/app/data/*
!backend/app/data/.gitkeep
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.mypy_cache/
.coverage
coverage.xml
*.log

# Frontend build artefacts
node_modules/
dist/
.vite/

# macOS
.DS_Store

# IDE
.idea/
*.iml
